# Redis (free tier) — powers the anonymous visit counter.
# Add it via the Vercel Marketplace (Storage tab → Upstash → Redis), which
# names these KV_REST_API_URL / KV_REST_API_TOKEN; or create a database
# directly at https://upstash.com, which names them UPSTASH_REDIS_REST_*
# instead (lib/redis.ts checks both). If left unset, the counter simply
# hides itself — everything else still works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public site URL, used for metadata (canonical/OG URLs) and sitemap.xml.
# Set this once you know the final domain or *.vercel.app slug.
NEXT_PUBLIC_SITE_URL=
