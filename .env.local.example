# Upstash Redis (free tier) — powers the anonymous visit counter.
# Create a database at https://upstash.com or via the Vercel Marketplace,
# then copy its REST credentials here (and set the same in Vercel env vars).
# If left unset, the counter simply hides itself — everything else still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for metadata (canonical/OG URLs) and sitemap.xml.
# Set this once you know the final domain or *.vercel.app slug.
NEXT_PUBLIC_SITE_URL=
